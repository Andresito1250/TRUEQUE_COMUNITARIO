# Copia este archivo como .env (nunca subas .env al repositorio)
NODE_ENV=development
PORT=3000

# Base de datos (docker-compose)
DATABASE_URL=postgresql://trueque:trueque@localhost:5433/trueque?schema=public

# JWT (cambia estos valores por cadenas largas y aleatorias)
JWT_ACCESS_SECRET=cambia-esto-access
JWT_REFRESH_SECRET=cambia-esto-refresh
JWT_ACCESS_MIN=15
JWT_REFRESH_TTL_DIAS=7

# Correo (Mailpit en local: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Trueque Comunitario <no-responder@trueque.local>"

# Almacenamiento S3 (SeaweedFS en local)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=trueque
# URL pública de los archivos (CDN o bucket público). Vacía = el API los sirve en /api/v1/archivos
ARCHIVOS_URL_PUBLICA=
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Orígenes permitidos para CORS (coma separada; * en desarrollo)
CORS_ORIGINS=*
