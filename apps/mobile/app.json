{
  "expo": {
    "name": "Trueque Comunitario",
    "slug": "trueque-comunitario",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trueque",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "co.edu.umb.truequecomunitario",
      "supportsTablet": false
    },
    "android": {
      "package": "co.edu.umb.truequecomunitario",
      "adaptiveIcon": {
        "backgroundColor": "#EEF2EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E6B30",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación aproximada para mostrarte trueques cerca de ti. Nunca mostramos tu ubicación exacta a otras personas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para que agregues imágenes a tus publicaciones.",
          "cameraPermission": "Necesitamos la cámara para que tomes fotos de lo que quieres cambiar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
